# Copy this file to .env and adjust the values. Never commit .env.
# These are example values for local development only, not real secrets.

# PostgreSQL container (single instance, one database per service)
POSTGRES_USER=payments
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# One database per service (created by infra/postgres/init-databases.sql)
ACCOUNT_DB_NAME=account_db
TRANSFER_DB_NAME=transfer_db
NOTIFICATION_DB_NAME=notification_db
