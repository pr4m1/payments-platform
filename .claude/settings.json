{
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(docker compose *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git merge *)",
      "Bash(rm -rf *)",
      "Read(.env)"
    ]
  }
}
